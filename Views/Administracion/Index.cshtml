@{
    ViewData["Title"] = "Portal Administración";
}

<div class="container py-5 text-center">

    <h2 class="fw-bold text-success mb-4">Portal de Administración</h2>

    <p class="text-muted mb-4">
        Bienvenido al portal de administración. Desde aquí puedes supervisar la gestión
        de estudiantes registrados en UAMPass.
    </p>

    <div class="mt-4">
        <a asp-controller="Administracion"
           asp-action="Estudiantes"
           class="btn btn-success px-4 py-2">
            📋 Ver Base de Datos de Estudiantes
        </a>
    </div>

</div>
