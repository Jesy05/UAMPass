@{
    ViewData["Title"] = "UAMPass - Portal de Pasantías";
}

<div class="d-flex flex-column align-items-center justify-content-center min-vh-100 text-center" style="background-color: #f9f9f9;">

    <div class="card shadow p-4 border-0" style="max-width: 900px; border-radius: 25px;">

        <h1 class="fw-bold mb-2" style="color: #04a7ad;">Bienvenido a UAMPass</h1>
        <p class="text-muted mb-4">Selecciona tu portal para continuar</p>

        <div class="row justify-content-center g-4">

            <!-- Portal Estudiantes -->
            <div class="col-md-4">
                <div class="card shadow border-0" style="border-radius: 20px; overflow: hidden;">
                    <img src="~/images/portal_estudiantes.jpg" class="card-img-top"
                         style="height: 240px; object-fit: cover;">
                    <div class="card-body text-center">
                        <a asp-controller="EstudianteAuth" asp-action="Landing"
                           class="btn btn-lg w-100 text-white"
                           style="background-color: #04a7ad; border-radius: 12px;">
                            Portal Estudiantes
                        </a>
                    </div>
                </div>
            </div>

            <!-- Portal Empresas -->
            <div class="col-md-4">
                <div class="card shadow border-0" style="border-radius: 20px; overflow: hidden;">
                    <img src="~/images/portal_empresas.jpg" class="card-img-top"
                         style="height: 240px; object-fit: cover;">
                    <div class="card-body text-center">
                        <a asp-controller="Empresas" asp-action="Index"
                           class="btn btn-lg w-100"
                           style="border: 2px solid #04a7ad; color: #04a7ad; border-radius: 12px;">
                            Portal Empresas
                        </a>
                    </div>
                </div>
            </div>

            <!-- Portal Administración -->
            <div class="col-md-4">
                <div class="card shadow border-0" style="border-radius: 20px; overflow: hidden;">
                    <img src="~/images/portal_admin.jpg" class="card-img-top"
                         style="height: 240px; object-fit: cover;">
                    <div class="card-body text-center">
                        <a asp-controller="Administracion" asp-action="Index"
                           class="btn btn-lg w-100 text-white"
                           style="background-color: #027d81; border-radius: 12px;">
                            Portal Administración
                        </a>
                    </div>
                </div>
            </div>

        </div>

    </div>

    <footer class="mt-5 text-muted small">
        <p>© 2025 Universidad Americana (UAM) · Proyecto UAMPass</p>
    </footer>

</div>
