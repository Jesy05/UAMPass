@model UAMPass.Models.Estudiante

<h2 style="margin-bottom: 20px;">Editar Estudiante</h2>

<form asp-action="Edit" method="post" style="max-width: 400px;">
    <input type="hidden" asp-for="Id" />

    <div style="margin-bottom: 10px;">
        <label>Nombre</label><br />
        <input asp-for="Nombre" style="width: 100%;" />
    </div>

    <div style="margin-bottom: 10px;">
        <label>Correo</label><br />
        <input asp-for="Correo" style="width: 100%;" />
    </div>

    <div style="margin-bottom: 10px;">
        <label>Facultad</label><br />
        <input asp-for="Facultad" style="width: 100%;" />
    </div>

    <div style="margin-bottom: 10px;">
        <label>CIF</label><br />
        <input asp-for="CIF" style="width: 100%;" />
    </div>

    <div style="margin-bottom: 10px;">
        <label>Carreras (separadas por coma)</label><br />
        <input name="Carreras" value="@string.Join(", ", Model.Carreras ?? new List<string>())" style="width: 100%;" />
    </div>

    <div style="margin-bottom: 10px;">
        <label>Nueva contraseña (opcional)</label><br />
        <input asp-for="ContrasenaHash" type="password" style="width: 100%;" />
    </div>

    <button type="submit">Guardar</button>
</form>

<p style="margin-top: 20px;">
    <a asp-action="Index">Volver</a>
</p>
