@model UAMPass.Models.Administrador
@{
    ViewData["Title"] = "Iniciar Sesión Administrador";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 90vh; background: linear-gradient(135deg, #e6f4ea, #ffffff);">
    <div class="card shadow-lg border-0" style="width: 420px; border-radius: 16px;">

        <div class="card-body p-4">
            <h3 class="text-center fw-bold text-success mb-3">Portal de Administradores</h3>
            <p class="text-center text-muted mb-4">Inicia sesión para acceder al panel de control total.</p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger text-center">
                    @ViewBag.Error
                </div>
            }

            <form asp-controller="AdminAuth" asp-action="Login" method="post">

                <div class="mb-3">
                    <label class="form-label fw-semibold">Usuario</label>
                    <input type="text" name="usuario" class="form-control" placeholder="Ingresa tu usuario" required />
                    </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Contraseña</label>
                    <input type="password" name="contrasena" class="form-control" placeholder="Ingresa tu contraseña" required />
                </div>

                <button type="submit" class="btn btn-success w-100 py-2 fw-bold">
                    Iniciar Sesión
                </button>

                <div class="text-center mt-3">
                    <a asp-controller="AdminAuth" asp-action="Registro" class="text-success fw-semibold" style="text-decoration:none;">
                        ¿Olvidaste tu contraseña? 
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

