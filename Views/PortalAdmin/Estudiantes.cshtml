@model IEnumerable<UAMPass.Models.Estudiante>

@{
    ViewData["Title"] = "Estudiantes";
    var total = Model?.Count() ?? 0;

    string search = ViewBag.Search as string ?? "";
    string letraSel = ViewBag.Letra as string ?? "Todos";

    string[] letras = new[]
    {
        "A","B","C","D","E","F","G","H","I","J","K","L","M",
        "N","Ñ","O","P","Q","R","S","T","U","V","W","X","Y","Z"
    };
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 tabla-estudiantes-container">

            <div class="card shadow-sm border-0 rounded-4">

                <!-- Encabezado -->
                <div class="card-header text-white border-0 rounded-top-4" style="background-color:#00A8A8;">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <h3 class="mb-0 fw-semibold">
                            Estudiantes registrados
                        </h3>

                        <a asp-action="Create" asp-controller="Estudiantes"
                           class="btn btn-sm btn-light fw-semibold rounded-pill px-3">
                            + Crear nuevo
                        </a>
                    </div>
                </div>

                <!-- Filtros + Tabla -->
                <div class="card-body p-0">

                    <!-- Filtros superiores -->
                    <div class="filters-wrapper px-4 pt-4 pb-3">

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">

                            <!-- Total estudiantil -->
                            <div class="badge total-badge px-3 py-2 rounded-pill shadow-sm">
                                Total estudiantil: @total
                            </div>

                            <!-- Buscador -->
                            <form asp-action="Estudiantes"
                                  asp-controller="Administradores"
                                  method="get"
                                  class="d-flex align-items-center gap-2">
                                <input type="hidden" name="letra" value="@letraSel" />

                                <input type="text"
                                       name="search"
                                       value="@search"
                                       class="form-control form-control-sm"
                                       placeholder="Buscar por nombre o correo..." />

                                <button type="submit"
                                        class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                    Buscar
                                </button>
                            </form>
                        </div>

                        <!-- Barra alfabética simple -->
                        <div class="mb-2">
                            <div class="fw-semibold mb-1">Nombre</div>

                            <div class="d-flex flex-wrap align-items-center gap-1">
                                <!-- Todos -->
                                <a asp-action="Estudiantes"
                                   asp-controller="Administradores"
                                   asp-route-letra="Todos"
                                   asp-route-search="@search"
                                   class="letter-link @(letraSel == "Todos" ? "letter-active" : "")">
                                    Todos
                                </a>

                                @foreach (var letra in letras)
                                {
                                    <a asp-action="Estudiantes"
                                       asp-controller="Administradores"
                                       asp-route-letra="@letra"
                                       asp-route-search="@search"
                                       class="letter-link @(letraSel == letra ? "letter-active" : "")">
                                        @letra
                                    </a>
                                }
                            </div>
                        </div>

                    </div>

                    <!-- Tabla -->
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-estudiantes mb-0">
                            <thead>
                                <tr>
                                    <th>NOMBRE</th>
                                    <th>CORREO</th>
                                    <th>FACULTAD</th>
                                    <th>CIF</th>
                                    <th>CARRERAS</th>
                                    <th class="text-center">ACCIONES</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            No hay estudiantes registrados aún.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr class="student-row">
                                            <td class="fw-semibold student-name">@item.Nombre</td>
                                            <td>@item.Correo</td>
                                            <td>@item.Facultad</td>
                                            <td>@item.CIF</td>

                                            <td>
                                                <div class="d-flex flex-wrap gap-1">
                                                    @foreach (var carrera in item.Carreras)
                                                    {
                                                        <span class="career-pill">@carrera</span>
                                                    }
                                                </div>
                                            </td>

                                            <td class="text-center">
                                                <div class="action-buttons">
                                                    <a asp-action="Details"
                                                       asp-controller="Estudiantes"
                                                       asp-route-id="@item.Id"
                                                       class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                        Ver
                                                    </a>

                                                    <a asp-action="Edit"
                                                       asp-controller="Estudiantes"
                                                       asp-route-id="@item.Id"
                                                       class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                                        Editar
                                                    </a>

                                                    <a asp-action="Delete"
                                                       asp-controller="Estudiantes"
                                                       asp-route-id="@item.Id"
                                                       class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                        Eliminar
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                </div> <!-- card-body -->

            </div> <!-- card -->

        </div>
    </div>
</div>

<style>
    body {
        background-color: #f3f4f6;
    }

    .tabla-estudiantes-container {
        max-width: 100%;
    }

    .card {
        border-radius: 18px;
    }

    .card-header {
        padding-top: 1.1rem;
        padding-bottom: 1.1rem;
    }

    .filters-wrapper {
        border-bottom: 1px solid #e5e7eb;
    }

    /* Badge Total Estudiantil */
    .total-badge {
        background-color: #e6f6f7;
        color: #027d81;
        font-weight: 600;
        border: 1px solid #027d81;
    }

    /* Letras del abecedario */
    .letter-link {
        font-size: 0.95rem;
        color: #027d81;
        font-weight: 500;
        text-decoration: none;
        margin-right: 0.35rem;
    }

        .letter-link:hover {
            text-decoration: underline;
            color: #015c5f;
        }

    .letter-active {
        font-weight: 700;
        text-decoration: underline;
        color: #027d81;
    }

    .table-estudiantes th,
    .table-estudiantes td {
        padding: 14px 18px;
        vertical-align: middle;
    }

    .table-estudiantes .student-row {
        height: 78px;
        vertical-align: middle;
    }

    .student-name {
        font-size: 0.97rem;
        line-height: 1.1rem;
        white-space: normal;
        word-break: break-word;
    }

    .table-estudiantes tbody tr:hover {
        background-color: #f8fbfd;
    }

    .career-pill {
        background-color: #00B7FF;
        color: white;
        border-radius: 999px;
        padding: 2px 10px;
        font-size: 0.75rem;
        font-weight: 500;
        white-space: nowrap;
    }

    .action-buttons {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        flex-wrap: nowrap;
    }

        .action-buttons .btn-sm {
            font-size: 0.78rem;
            padding: 0.20rem 0.7rem;
        }
</style>
