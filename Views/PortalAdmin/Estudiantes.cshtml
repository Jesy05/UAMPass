@model IEnumerable<UAMPass.Models.Estudiante>

@{
    ViewData["Title"] = "Estudiantes";
    var total = Model?.Count() ?? 0;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 tabla-estudiantes-container">


            <div class="card shadow-sm border-0 rounded-4">

                <!-- Encabezado -->
                <div class="card-header text-white border-0 rounded-top-4" style="background-color:#00A8A8;">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <h3 class="mb-0 fw-semibold">
                            Estudiantes registrados <span class="fw-bold">(@total)</span>
                        </h3>

                        <a asp-action="Create" asp-controller="Estudiantes"
                           class="btn btn-sm btn-light fw-semibold rounded-pill px-3">
                            + Crear nuevo
                        </a>
                    </div>
                </div>

                <!-- Tabla -->
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-estudiantes mb-0">
                            <thead class="table-light">
                                <tr class="small text-uppercase text-muted">
                                    <th style="width:18%">Nombre</th>
                                    <th style="width:20%">Correo</th>
                                    <th style="width:15%">Facultad</th>
                                    <th style="width:10%">CIF</th>
                                    <th style="width:22%">Carreras</th>
                                    <th class="text-center" style="width:15%">Acciones</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            No hay estudiantes registrados aún.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr class="student-row">
                                            <td class="fw-semibold student-name">@item.Nombre</td>
                                            <td>@item.Correo</td>
                                            <td>@item.Facultad</td>
                                            <td>@item.CIF</td>

                                            <td>
                                                <div class="d-flex flex-wrap gap-1">
                                                    @foreach (var carrera in item.Carreras)
                                                    {
                                                        <span class="career-pill">@carrera</span>
                                                    }
                                                </div>
                                            </td>

                                            <td class="text-center">
                                                <div class="action-buttons">
                                                    <a asp-action="Details" asp-controller="Estudiantes" asp-route-id="@item.Id"
                                                       class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                        Ver
                                                    </a>

                                                    <a asp-action="Edit" asp-controller="Estudiantes" asp-route-id="@item.Id"
                                                       class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                                        Editar
                                                    </a>

                                                    <a asp-action="Delete" asp-controller="Estudiantes" asp-route-id="@item.Id"
                                                       class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                        Eliminar
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>

                        </table>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

<style>
    body {
        background-color: #f3f4f6;
    }

    .tabla-estudiantes-container {
        max-width: 100%;
    }

    .card {
        border-radius: 18px;
    }

    .card-header {
        padding-top: 1.1rem;
        padding-bottom: 1.1rem;
    }

    .table-estudiantes th,
    .table-estudiantes td {
        padding: 14px 18px;
        vertical-align: middle;
    }

    .table-estudiantes .student-row {
        height: 78px;
        vertical-align: middle;
    }

    .student-name {
        font-size: 0.97rem;
        line-height: 1.1rem;
        white-space: normal;
        word-break: break-word;
    }

    .table-estudiantes tbody tr:hover {
        background-color: #f8fbfd;
    }

    /* Chips de carreras: mismo celeste que ya usabas */
    .career-pill {
        background-color: #00B7FF;
        color: white;
        border-radius: 999px;
        padding: 2px 10px;
        font-size: 0.75rem;
        font-weight: 500;
        white-space: nowrap;
    }

    /* Botones en una línea horizontal */
    .action-buttons {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        white-space: nowrap;
        flex-wrap: nowrap;
    }

    .pagination .page-link {
        border-radius: 999px;
        padding: 0.25rem 0.75rem;
        font-size: 0.85rem;
    }

    .action-buttons .btn-sm {
        font-size: 0.78rem; /* un poco más pequeño */
        padding: 0.20rem 0.7rem; /* menos ancho */
    }

    /* Si quieres, reduce un pelín el gap también */
    .action-buttons {
        gap: 8px;
    }

</style>
