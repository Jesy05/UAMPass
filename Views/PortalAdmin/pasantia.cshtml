@using UAMPass.Models.Dto
@using Microsoft.AspNetCore.Http
@model PasantiaDto.CreatePasantia

@{
    ViewData["Title"] = "Gestión Global de Pasantías";

    // Letras para el filtro por empresa
    string[] letras = new[]
    {
        "A","B","C","D","E","F","G","H","I","J","K","L","M",
        "N","Ñ","O","P","Q","R","S","T","U","V","W","X","Y","Z"
    };
}

<div class="card shadow-sm border-0 rounded-4 p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary">Listado Global de Pasantías</h2>
            <p class="text-muted">Administra las ofertas de todas las empresas registradas.</p>
        </div>
    </div>

    <!-- 🔸 Filtros personalizados (Total + buscador + abecedario) -->
    <div class="mb-3">

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
            <!-- Total pasantías -->
            <div id="totalPasantiasBadge"
                 class="badge total-pasantias-badge px-3 py-2 rounded-pill shadow-sm">
                Total pasantías: 0
            </div>

            <!-- Buscador personalizado -->
            <div class="d-flex align-items-center gap-2">
                <input id="searchPasantias"
                       type="text"
                       class="form-control form-control-sm busqueda-pasantias-input"
                       placeholder="Buscar por empresa o título..." />

                <button id="btnBuscarPasantias"
                        type="button"
                        class="btn btn-sm btn-busqueda-pasantias rounded-pill px-3">
                    Buscar
                </button>
            </div>
        </div>

        <!-- Abecedario por EMPRESA -->
        <div>
            <div class="fw-semibold mb-1">Empresa</div>
            <div class="d-flex flex-wrap align-items-center gap-1" id="alphaFiltroPasantias">
                <a href="#" data-letter="Todos"
                   class="letter-link letter-active">Todos</a>

                @foreach (var letra in letras)
                {
                    <a href="#"
                       data-letter="@letra"
                       class="letter-link">@letra</a>
                }
            </div>
        </div>

    </div>

    <div class="table-responsive">
        <table id="tablaPasantiasAdmin" class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Empresa</th>
                    <th>Título</th>
                    <th>Carreras</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- Modales -->

<div class="modal fade" id="modalEditarPasantia" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">Editar Pasantía (Modo Admin)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formEditarPasantia">
                    <input type="hidden" id="editarId">

                    <div class="mb-3">
                        <label for="editarTitulo" class="form-label fw-bold">Título</label>
                        <input type="text" class="form-control" id="editarTitulo" required>
                    </div>

                    <div class="mb-3">
                        <label for="editarDescripcion" class="form-label fw-bold">Descripción</label>
                        <textarea class="form-control" id="editarDescripcion" rows="3" required></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="editarCarreras" class="form-label fw-bold">Carreras Permitidas</label>
                        <input type="text" class="form-control" id="editarCarreras" placeholder="Ej: Sistemas, Industrial">
                        <small class="text-muted">Separa las carreras por comas.</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-primary" id="btnGuardarCambios">Guardar Cambios</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalConfirmarEliminar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Eliminar Pasantía</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Estás seguro de que deseas eliminar esta pasantía permanentemente?</p>
                <p class="text-danger small mb-0">Esta acción borrará también las postulaciones asociadas.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="btnConfirmarEliminar">Sí, Eliminar</button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Badge Total pasantías */
    .total-pasantias-badge {
        background-color: #fff7e6;
        color: #efac45;
        font-weight: 600;
        border: 1px solid #efac45;
    }

    /* Buscador personalizado */
    .busqueda-pasantias-input:focus {
        border-color: #efac45;
        box-shadow: 0 0 0 0.15rem rgba(239, 172, 69, 0.35);
    }

    .btn-busqueda-pasantias {
        background-color: #efac45;
        border-color: #efac45;
        color: #fff;
        font-weight: 600;
    }

        .btn-busqueda-pasantias:hover {
            background-color: #e49b29;
            border-color: #e49b29;
            color: #fff;
        }

    /* Letras del abecedario */
    .letter-link {
        font-size: 0.95rem;
        color: #04098b 
        font-weight: 500;
        text-decoration: none;
        margin-right: 0.35rem;
    }

        .letter-link:hover {
            text-decoration: underline;
            color: #04098b
        }

    .letter-active {
        font-weight: 700;
        text-decoration: underline;
        color: #04098b
    }

    /* 🔸 Chips de carreras (columna "Carreras") */
    .badge.bg-info {
        background-color: #efac45 !important;
        color: #ffffff !important;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 999px;
    }
</style>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <script>
        $(document).ready(function () {

            // Inicializamos DataTable y guardamos referencia
            var tabla = $('#tablaPasantiasAdmin').DataTable({
                ajax: {
                    url: `/api/admin/pasantias`,
                    dataSrc: ''
                },
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                },
                // Usamos solo tabla + info + paginación (buscador nativo oculto)
                dom: 'rt<"bottom"lip>',
                columns: [
                    { data: 'idPasantia', visible: false },
                    {
                        data: 'nombreEmpresa',
                        defaultContent: 'N/A',
                        render: function (data) {
                            return `<span class="fw-bold text-primary">${data}</span>`;
                        }
                    },
                    { data: 'titulo' },
                    {
                        data: 'carrerasPermitidas',
                        render: function (data) {
                            if (!data) return "";
                            return data.split(',').map(c =>
                                `<span class="badge bg-info me-1">${c.trim()}</span>`
                            ).join('');
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        className: "text-center",
                        render: function (data, type, row) {
                            return `
                                <div class="d-flex justify-content-center gap-2">
                                    <button class="btn btn-sm btn-warning btn-editar text-white"
                                            title="Editar"
                                            data-id="${row.idPasantia}"
                                            data-titulo="${row.titulo}"
                                            data-descripcion="${row.descripcion}"
                                            data-carreras="${row.carrerasPermitidas}">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger btn-eliminar"
                                            title="Eliminar"
                                            data-id="${row.idPasantia}">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </div>
                            `;
                        }
                    }
                ]
            });

            // Actualizamos el contador total cuando llega el ajax
            tabla.on('xhr', function () {
                var total = tabla.rows().count();
                $('#totalPasantiasBadge').text('Total pasantías: ' + total);
            });

            // --- BÚSQUEDA PERSONALIZADA (empresa + título) ---
            $('#btnBuscarPasantias').on('click', function () {
                var texto = $('#searchPasantias').val();
                tabla.search(texto).draw();
                // limpiamos selección de letra porque ahora manda el texto
                $('#alphaFiltroPasantias a').removeClass('letter-active');
            });

            $('#searchPasantias').on('keyup', function (e) {
                if (e.key === 'Enter') {
                    $('#btnBuscarPasantias').click();
                }
            });

            // --- FILTRO POR ABECEDARIO (columna Empresa = índice 1) ---
            $('#alphaFiltroPasantias').on('click', 'a', function (e) {
                e.preventDefault();

                $('#alphaFiltroPasantias a').removeClass('letter-active');
                $(this).addClass('letter-active');

                var letra = $(this).data('letter');

                // limpiar caja de texto
                $('#searchPasantias').val('');
                tabla.search(''); // limpiamos búsqueda global

                if (letra === 'Todos') {
                    tabla.column(1).search('').draw();
                } else {
                    var regex = '^' + letra;
                    tabla.column(1).search(regex, true, false).draw();
                }
            });

            // VARIABLES GLOBALES
            var idSeleccionado = null;

            // --- LÓGICA DE ELIMINAR ---
            $(document).on('click', '.btn-eliminar', function () {
                idSeleccionado = $(this).data('id');
                $('#modalConfirmarEliminar').modal('show');
            });

            $('#btnConfirmarEliminar').on('click', function () {
                $.ajax({
                    url: `/api/admin/pasantias/${idSeleccionado}`,
                    type: 'DELETE',
                    success: function (response) {
                        $('#modalConfirmarEliminar').modal('hide');
                        tabla.ajax.reload();
                    },
                    error: function (xhr) {
                        alert("Error al eliminar: " + xhr.responseText);
                    }
                });
            });

            // --- LÓGICA DE EDITAR ---
            $(document).on('click', '.btn-editar', function () {
                $('#editarId').val($(this).data('id'));
                $('#editarTitulo').val($(this).data('titulo'));
                $('#editarDescripcion').val($(this).data('descripcion'));
                $('#editarCarreras').val($(this).data('carreras'));

                $('#modalEditarPasantia').modal('show');
            });

            $('#btnGuardarCambios').on('click', function () {
                const id = $('#editarId').val();

                const dataToSend = {
                    titulo: $('#editarTitulo').val(),
                    descripcion: $('#editarDescripcion').val(),
                    RequiredCareersCsv: $('#editarCarreras').val()
                };

                $.ajax({
                    url: `/api/admin/pasantias/${id}`,
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify(dataToSend),
                    success: function () {
                        $('#modalEditarPasantia').modal('hide');
                        tabla.ajax.reload();
                        alert("Pasantía actualizada correctamente.");
                    },
                    error: function (xhr) {
                        alert("Error al actualizar: " + xhr.status);
                    }
                });
            });
        });
    </script>
}
