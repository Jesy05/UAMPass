@model UAMPass.Models.Administrador
@{
    ViewData["Title"] = "Mi Perfil";

    var mainColor = "#04a7ad";
    var lightColor = "#e0f7f7";
    var accentColor = "#007b85";
}

<div class="container mt-5">
    <div class="card shadow-lg p-5 border-0" style="border-radius:20px;">

        <div class="row align-items-center mb-4">
            <div class="col-md-3 text-center mb-4 mb-md-0">

                @* SOLUCIÓN: Usamos directamente la imagen por defecto.
                   Ya no intentamos leer 'Model.FotoPerfilPath' porque no existe en la BD.
                *@
                <img src="~/images/default-avatar.jpg"
                     class="rounded-circle shadow-sm"
                     style="width:160px; height:160px; object-fit:cover; border:5px solid @mainColor;"
                     alt="Foto de perfil" />

                @* Botón de Editar (Apunta a la acción Edit de PortalAdmin) *@
                <a asp-controller="PortalAdmin" asp-action="Edit" asp-route-id="@Model?.Id"
                   class="btn btn-outline-primary btn-sm mt-3"
                   style="--bs-btn-color:@mainColor; --bs-btn-border-color:@mainColor; --bs-btn-hover-bg:@mainColor; --bs-btn-hover-border-color:@mainColor;">
                    <i class="bi bi-pencil-square me-1"></i> Editar perfil
                </a>
            </div>

            <div class="col-md-9">
                <h2 class="display-6 fw-bolder mb-2 text-dark">
                    @(string.IsNullOrEmpty(Model?.Nombre) ? "Nombre no disponible" : Model.Nombre)
                </h2>

                <hr class="mt-0 mb-3" style="border-top: 2px solid @lightColor;">

                <ul class="list-unstyled">
                    <li class="mb-1">
                        <strong class="text-secondary me-2">
                            <i class="bi bi-envelope-fill" style="color:@mainColor;"></i> Correo:
                        </strong>
                        @(string.IsNullOrEmpty(Model?.Correo) ? "-" : Model.Correo)
                    </li>

                    <li class="mb-1">
                        <strong class="text-secondary me-2">
                            <i class="bi bi-person-badge-fill" style="color:@mainColor;"></i> Usuario:
                        </strong>
                        @(string.IsNullOrEmpty(Model?.Usuario) ? "-" : Model.Usuario)
                    </li>

                    <li>
                        <strong class="text-secondary me-2">
                            <i class="bi bi-shield-lock-fill" style="color:@mainColor;"></i> Rol:
                        </strong>
                        <span class="badge bg-secondary">Administrador</span>
                    </li>
                </ul>
            </div>
        </div>

        <hr class="my-4">

        <div class="row align-items-center">
            <div class="col-md-8">
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-person-check-fill me-2" style="color:@mainColor;"></i>
                    Bienvenida al Panel de Administrador
                </h5>

                <p class="text-muted small mb-2">
                    ¡Hola @(string.IsNullOrEmpty(Model?.Nombre) ? "Administrador" : Model.Nombre)!
                    Desde aquí tienes el control total para gestionar estudiantes, empresas y pasantías.
                </p>

                <a asp-controller="PortalAdmin" asp-action="Index"
                   class="btn btn-primary"
                   style="background-color:@mainColor; border-color:@mainColor; --bs-btn-hover-bg:@accentColor;">
                    <i class="bi bi-house-door-fill me-1"></i> Ir al Menú
                </a>
            </div>
        </div>
    </div>
</div>