@using UAMPass.Models.Dto
@model LoginEstudianteDTO
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 90vh; background: linear-gradient(135deg, #e6f4ea, #ffffff);">
    <div class="card shadow-lg border-0" style="width: 420px; border-radius: 16px;">

        <div class="card-body p-4">
            <h3 class="text-center fw-bold text-success mb-3">Portal de Estudiantes</h3>
            <p class="text-center text-muted mb-4">Inicia sesión para acceder a tus pasantías, perfil y notificaciones.</p>

            @if (ViewData["Error"] != null)
            {
                <div class="alert alert-danger text-center">
                    @ViewData["Error"]
                </div>
            }

            <form asp-action="Login" method="post">

                <!-- Correo -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Correo institucional</label>
                    <input asp-for="Correo" class="form-control" placeholder="ejemplo@uamv.edu.ni" />
                    <span asp-validation-for="Correo" class="text-danger"></span>
                </div>

                <!-- Contraseña -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Contraseña</label>
                    <input asp-for="Contrasena" class="form-control" type="password" placeholder="Ingresa tu contraseña" />
                    <span asp-validation-for="Contrasena" class="text-danger"></span>
                </div>

                <!-- Botón -->
                <button type="submit" class="btn btn-success w-100 py-2 fw-bold">
                    Iniciar Sesión
                </button>

                <!-- Links -->
                <div class="text-center mt-3">
                    <a asp-action="Recuperar" class="text-success fw-semibold" style="text-decoration:none;">
                        ¿Olvidaste tu contraseña?
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
