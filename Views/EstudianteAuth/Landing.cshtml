@{
    ViewData["Title"] = "Portal Estudiantes";
}

<div class="d-flex flex-column align-items-center justify-content-center min-vh-100 bg-light">

    <div class="card shadow p-5 border-0 text-center" style="max-width: 500px; border-radius: 20px;">
        <h2 class="fw-bold mb-3" style="color: #04a7ad;">Portal de Estudiantes</h2>
        <p class="text-muted mb-4">Selecciona una opción para continuar</p>

        <div class="d-grid gap-3">

            <!-- Botón Registrarse -->
            <a asp-controller="Estudiantes"
               asp-action="Create"
               class="btn btn-lg text-white"
               style="background-color: #04a7ad; border-radius: 10px;">
                Registrarse
            </a>

            <!-- Botón Iniciar Sesión -->
            <a asp-controller="EstudianteAuth"
               asp-action="Login"
               class="btn btn-lg text-white"
               style="background-color: #027d81; border-radius: 10px;">
                Iniciar Sesión
            </a>

        </div>
    </div>
</div>
