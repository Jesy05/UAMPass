@model UAMPass.Models.Dto.PasantiaDto
@{
    ViewData["Title"] = "Postulaciones";
}

<h2>Postulaciones</h2>



<!-- DATATABLE -->
<table id="postulacionesTable" class="table table-striped table-bordered" style="width:100%">
    <thead>
        <tr>
            <th>ID</th>
            <th>Estudiante</th>
            <th>CV</th>
            <th>Pasantia</th>
            <th>Fecha Aplicacion</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

<!-- MODAL APLICAR -->
<div class="modal fade" id="aplicarModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Confirmar cambio de estado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <label class="form-label">Comentario sobre desempeño del estudiante (opcional)</label>
                <textarea id="comentarioAplicacion" class="form-control" rows="3"></textarea>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button" id="btnEnviarAplicacion" class="btn btn-primary">
                    Aplicar
                </button>
            </div>

        </div>
    </div>
</div>


@section Scripts {
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


    <script>
        $(document).ready(function () {
            $('#postulacionesTable').DataTable({
                "ajax": {
                    "url": "/Postulaciones/GetPostulaciones",
                    "type": "GET",
                    "dataSrc": "data"
                },
                "columns": [
                    { "data": "id", "visible": false },
                    { "data": "estudiante" },       
                    {data: "cv",
                        render: function (data) {
                            return data
                                ? `<a href="${data}" target="_blank">Abrir CV</a>`
                                : "Sin CV";
                        }
                    },
                    { "data": "pasantia" },
                    { "data": "fechaAplicacion" },
                    { "data": "estado" },
                    {
                        "data": "Acciones",
                        "render": function (data, type, row) {
                            return `
                                <button class="btn btn-success btn-entrevista" data-id="${row.id}">Entrevistar</button>
                                <button class="btn btn-success btn-aceptar" data-id="${row.id}">Aceptar</button>
                                <button class="btn btn-warning btn-completa" data-id="${row.id}">Completada</button>
                                <button class="btn btn-danger btn-rechazar" data-id="${row.id}">Rechazar</button>

                            `;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                }
            });
        });

        $(document).on('click', '.btn-entrevista', function () {
            var id = $(this).data('id');
            var estado = "Interview";

            // Guardar datos en el botón de enviar
            $('#btnEnviarAplicacion').data('id', id);
            $('#btnEnviarAplicacion').data('estado', estado);

            // Abrir el modal
            $('#aplicarModal').modal('show');
        });

        // Cuando se confirma en el modal
        $('#btnEnviarAplicacion').on('click', function () {
            var id = $(this).data('id');
            var estado = $(this).data('estado');
            var comentario = $('#comentarioAplicacion').val();

            $.ajax({
                url: '/Postulaciones/CambiarEstado',
                type: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify({ id: id, estado: estado, comentarios: comentario }),
                success: function (response) {
                    $('#aplicarModal').modal('hide');
                    $('#comentarioAplicacion').val('');
                    if (response.success) {
                        alert("Estado cambiado a: " + response.nuevoEstado);
                        $('#postulacionesTable').DataTable().ajax.reload();
                    } else {
                        alert("Error: " + response.mensaje);
                    }
                }
            });
        });


        $(document).on('click', '.btn-aceptar', function () {
            var id = $(this).data('id');
            var estado = "Accepted";
            var comentario = $('#comentarioAplicacion').val();

             // Guardar datos en el botón de enviar
            $('#btnEnviarAplicacion').data('id', id);
            $('#btnEnviarAplicacion').data('estado', estado);

            // Abrir el modal
            $('#aplicarModal').modal('show');
           
        });

        $(document).on('click', '.btn-rechazar', function () {
            var id = $(this).data('id');
            var estado = "Rejected";
            var comentario = $('#comentarioAplicacion').val();


             // Guardar datos en el botón de enviar
            $('#btnEnviarAplicacion').data('id', id);
            $('#btnEnviarAplicacion').data('estado', estado);

            // Abrir el modal
            $('#aplicarModal').modal('show');
        });

        $(document).on('click', '.btn-completa', function () {
            var id = $(this).data('id');
            var estado = "Completed";
            var comentario = $('#comentarioAplicacion').val();


             // Guardar datos en el botón de enviar
            $('#btnEnviarAplicacion').data('id', id);
            $('#btnEnviarAplicacion').data('estado', estado);

            // Abrir el modal
            $('#aplicarModal').modal('show');
        });
    </script>
}









