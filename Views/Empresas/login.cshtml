@using UAMPass.Models.Dto
@* CORREGIDO: LoginEmpresaDTO *@
@model LoginEmpresaDTO
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 90vh; background: linear-gradient(135deg, #e6f4ea, #ffffff);">
    <div class="card shadow-lg border-0" style="width: 420px; border-radius: 16px;">

        <div class="card-body p-4">
            <h3 class="text-center fw-bold text-success mb-3">Portal de Empresas</h3>
            <p class="text-center text-muted mb-4">Inicia sesión para acceder a tu perfil y notificaciones.</p>
            

            @if (ViewData["Error"] != null)
            {
                <div class="alert alert-danger text-center">
                    @ViewData["Error"]
                </div>
            }
            <form asp-action="Login" method="post"
                  asp-controller="Empresas">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Correo </label>
                    <input asp-for="ContactoEmail" class="form-control" placeholder="Ingresa tu correo" />
                    <span asp-validation-for="ContactoEmail" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Contraseña</label>
                    <input asp-for="Contrasena" class="form-control" type="password" placeholder="Ingresa tu contraseña" />
                    <span asp-validation-for="Contrasena" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success w-100 py-2 fw-bold">
                    Iniciar Sesión
                </button>

                <div class="text-center mt-3">
                    <a asp-controller="Empresas" asp-action="ForgotPassword" class="text-success fw-semibold" style="text-decoration:none;">
                        ¿Olvidaste tu contraseña?
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>