@* CORRECCIÓN: Usamos el nombre con Mayúscula *@
@model UAMPass.Models.Dto.CreateEmpresa
@{
    ViewData["Title"] = "Crear cuenta";
}
<h2>@ViewData["Title"]</h2>

<div class="container mt-5" style="max-width: 600px;">
    <h2 class="mb-4 text-center">Registro de Empresas</h2>
   
    <form asp-action="Register" method="post"
    asp-controller="Empresas">

        <div class="form-group mb-3">
            <label asp-for="Nombre">Nombre de la Empresa</label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="ContactoEmail">Email de Contacto</label>
            <input asp-for="ContactoEmail" class="form-control" type="email" />
            <span asp-validation-for="ContactoEmail" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="ContrasenaHash">Contraseña</label>

            <input asp-for="ContrasenaHash" class="form-control" />
            <span asp-validation-for="ContrasenaHash" class="text-danger" type="password"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Direccion">Dirección</label>
            <input asp-for="Direccion" class="form-control" />
        </div>

        <div class="form-group mb-4">
            <label>Sitio WEB</label>
            <input type="text" name="Sitioweb" class="form-control"/>
        </div>

        <button type="submit" class="btn btn-primary w-100">Registrarse</button>
    </form>

    <div class="text-center mt-3">
        <a asp-action="Login">¿Ya tienes una cuenta? Inicia sesión</a>
    </div>
</div>