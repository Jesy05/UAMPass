@{
    ViewData["Title"] = "Portal Empresas";
}

<div class="d-flex flex-column align-items-center justify-content-center min-vh-100 bg-light">

    <!-- inicio de sesión -->
    <div class="d-flex flex-column align-items-center justify-content-center min-vh-90 text-center" style="background-color: #f9f9f9;">
        <div class="card shadow p-5 border-0" style="max-width: 600px; border-radius: 20px;">
            <h1 class="fw-bold mb-4" style="color: #04a7ad;">Portal de Empresas</h1>
            <p class="text-muted mb-5">Selecciona tu acción para continuar</p>

            <div class="d-grid gap-3">
                <a asp-controller="Empresas" asp-action="Register"
                   class="btn btn-lg text-white"
                   style="background-color: #04a7ad; border-radius: 10px;">
                    Registrarse
                </a>

                <a asp-controller="Empresas" asp-action="Login"
                   class="btn btn-lg text-white"
                   style="background-color: #027d81; border-radius: 10px;">
                    Iniciar sesión
                </a>
            </div>
        </div>
    </div>
</div>

