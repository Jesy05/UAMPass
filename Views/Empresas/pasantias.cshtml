@using UAMPass.Models.Dto
@using Microsoft.AspNetCore.Http 
@model PasantiaDto.CreatePasantia
@{
    ViewData["Title"] = "Gestión de Pasantías";
}

<div class="d-flex justify-content-between mb-3">
    <h2>Listado de Pasantías</h2>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#crearModal">
        <i class="bi bi-plus-circle"></i> Crear
    </button>
</div>

<table id="tablaPasantias" class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Carreras Permitidas</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

<div class="modal fade" id="crearModal" tabindex="-1" aria-labelledby="crearModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Crear Nueva Pasantía</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formCrear">
                    <div class="mb-3">
                        <label for="Nombre" class="form-label">Nombre</label>
                        <input type="text" class="form-control" id="Nombre" name="Nombre" required />
                    </div>
                    <div class="mb-3">
                        <label for="Descripcion" class="form-label">Descripción</label>
                        <textarea class="form-control" id="Descripcion" name="Descripcion" rows="3" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="Carreras" class="form-label">Carreras Permitidas</label>
                        <select class="form-select" id="Carreras" name="Carreras" multiple required size="15">

                            <optgroup label="Facultad de Odontología">
                                <option value="Odontologia">Odontología</option>
                            </optgroup>

                            <optgroup label="Facultad de Ciencias Médicas">
                                <option value="Medicina">Medicina</option>
                                <option value="Psicologia">Psicología</option>
                                <option value="Nutricion">Nutrición</option>
                            </optgroup>

                            <optgroup label="Facultad de Marketing, Diseño y Comunicación">
                                <option value="Marketing">Marketing y Publicidad</option>
                                <option value="Diseno">Diseño y Comunicación Visual</option>
                                <option value="Comunicacion">Comunicación y Relaciones Públicas</option>
                            </optgroup>

                            <optgroup label="Facultad de Ciencias Administrativas y Económicas">
                                <option value="AdminEmpresas">Administración de Empresas</option>
                                <option value="Contabilidad">Contabilidad y Finanzas</option>
                                <option value="Economia">Economía Empresarial</option>
                                <option value="NegociosInt">Negocios Internacionales</option>
                            </optgroup>

                            <optgroup label="Facultad de Ingeniería y Arquitectura">
                                <option value="Arquitectura">Arquitectura</option>
                                <option value="IngCivil">Ingeniería Civil</option>
                                <option value="IngIndustrial">Ingeniería Industrial</option>
                                <option value="IngSistemas">Ingeniería en Sistemas de Información</option>
                            </optgroup>

                            <optgroup label="Facultad de Ciencias Jurídicas, Humanidades y RR.II.">
                                <option value="Derecho">Derecho</option>
                                <option value="Diplomacia">Diplomacia y Relaciones Internacionales</option>
                            </optgroup>

                        </select>
                        <small class="text-muted">Mantén presionado Ctrl para seleccionar varias.</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" form="formCrear" class="btn btn-success">Guardar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para editar pasantía -->
<div class="modal fade" id="modalEditarPasantia" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar Pasantía</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formEditarPasantia">
                    <input type="hidden" id="editarId">
                    <div class="mb-3">
                        <label for="editarTitulo" class="form-label">Nombre</label>
                        <input type="text" class="form-control" id="editarTitulo">
                    </div>
                    <div class="mb-3">
                        <label for="editarDescripcion" class="form-label">Descripcion</label>
                        <input type="text" class="form-control" id="editarDescripcion">
                    </div>
                    <div class="mb-3">
                        <label for="editarCarreras" class="form-label">Carreras Permitidas</label>
                        <select class="form-select" id="editarCarreras" multiple required>
                            <option value="Ingeniería">Ingeniería</option>
                            <option value="Medicina">Medicina</option>
                            <option value="Derecho">Derecho</option>
                            <option value="Sistemas">Sistemas</option>
                            <option value="Arquitectura">Arquitectura</option>
                        </select>
                        <small class="text-muted">Puedes seleccionar varias carreras.</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-primary" id="btnGuardarCambios">Guardar</button>
            </div>
        </div>
    </div>
</div>



<!-- Modal de confirmación eliminar -->
<div class="modal fade" id="modalConfirmarEliminar" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalLabel">Confirmación de Eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                ¿Estás segura de que deseas <strong>eliminar esta pasantía</strong>?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="btnConfirmarEliminar">Eliminar</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            var IdEmpersa = @Context.Session.GetString("empresaID")
            console.log(IdEmpersa)
            $('#tablaPasantias').DataTable({
                ajax: {
                    url: `/api/pasantias?IdEmpresa=${IdEmpersa}`,
                    dataSrc: ''
                },
                columns: [

                    { data: 'idPasantia', visible: false },
                    { data: 'titulo' },
                    { data: 'descripcion' },
                    { data: 'carrerasPermitidas' },
                    {
                        data: null,
                        render: function (data, type, row) {

                            return `

                                <button class="btn btn-warning btn-editar" data-id="${row.idPasantia}">Editar</button>
                                <button class="btn btn-danger btn-eliminar" data-id="${row.idPasantia}">Eliminar</button>
                            `;
                        },
                    }
                ]
            });

            $('#formCrear').on('submit', function (e) {
                e.preventDefault();

                const createPasantia = {
                    Titulo: $('#Nombre').val(),
                    Descripcion: $('#Descripcion').val(),
                    RequiredCareersCsv: $('#Carreras').val(),

                };

                $.ajax({
                    url: '/api/pasantias',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(createPasantia),
                    success: function () {
                        $('#crearModal').modal('hide');
                        $('#formCrear')[0].reset();
                        $('#tablaPasantias').DataTable().ajax.reload();
                    },
                    error: function (xhr) {
                        alert('Error: ' + xhr.responseText);
                    }
                });
            });
        });

        var idSeleccionado = null;

        $(document).on('click', '.btn-eliminar', function () {
            idSeleccionado = $(this).data('id');
            console.log(idSeleccionado)
            $('#modalConfirmarEliminar').modal('show');
        });


        $('#btnConfirmarEliminar').on('click', function () {
            $.ajax({
                url: `/Eliminar/pasantias/${idSeleccionado}`,
                type: 'DELETE',
                success: function (response) {
                    $('#modalConfirmarEliminar').modal('hide');
                    alert("Pasantía eliminada correctamente");
                    $('#tablaPasantias').DataTable().ajax.reload();
                },
                error: function () {
                    alert("Error al eliminar la pasantía");
                }
            });
        });

        $(document).on('click', '.btn-editar', function () {
            $('#editarId').val($(this).data('id'));
            $('#editarTitulo').val($(this).data('titulo'));
            $('#editarDescripcion').val($(this).data('descripcion'));
            $('#editarCarreras').val($(this).data('RequiredCareersCsv'));
            $('#modalEditarPasantia').modal('show');
        });

        $('#btnGuardarCambios').on('click', function () {
            const id = $('#editarId').val();
            const titulo = $('#editarTitulo').val();
            const descripcion = $('#editarDescripcion').val();
            const RequiredCareersCsv = $('#editarCarreras').val();


            $.ajax({
                url: `/Editar/pasantias/${id}`,
                type: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify({ titulo,descripcion,RequiredCareersCsv }),
                success: function (response) {
                    $('#modalEditarPasantia').modal('hide');
                    alert("Pasantía actualizada correctamente");
                    $('#tablaPasantias').DataTable().ajax.reload();
                },
                error: function () {
                    alert("Error al actualizar la pasantía");
                }
            });
        });

    </script>
}