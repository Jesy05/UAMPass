@{
    ViewData["Title"] = "UAMPass - Portal de Empresas";
}

<div class="d-flex flex-column align-items-center justify-content-center min-vh-100 text-center" style="background-color: #f9f9f9;">
    <div class="card shadow-lg border-0" style="width: 420px; border-radius: 16px;">

        <div class="card-body p-4">
            <h3 class="text-center fw-bold text-primary mb-3">Bienvenido a UAMPass Empresas</h3>
            <p class="text-center text-muted mb-4">¿Qué desea hacer hoy?.</p>

            <!-- Pasantías -->
            <div class="d-grid gap-3">
                        <a asp-controller="Empresas" asp-action="pasantias"
                           class="btn btn-lg w-100 text-white"
                           style="background-color: #04a7ad; border-radius: 12px;">
                            Pasantías
                        </a>

            <!-- Postulaciones -->
                <a asp-controller="Empresas" asp-action="postulaciones"
                    class="btn btn-lg w-100"
                    style="border: 2px solid #04a7ad; color: #04a7ad; border-radius: 12px;">
                    Postulaciones
                </a>
            </div>
        </div>

    </div>

    <footer class="mt-5 text-muted small">
        <p>© 2025 Universidad Americana (UAM) · Proyecto UAMPass</p>
    </footer>

</div>
