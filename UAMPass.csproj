<!--
  Archivo: UAMPass.csproj
  Propósito:
    - Definición del proyecto .NET Web (SDK Web) para la aplicación UAMPass.
    - Contiene TargetFramework, configuración de usings implícitos y referencias de paquetes NuGet.
  Funcionalidad:
    - Indica al SDK de .NET cómo compilar el proyecto y qué paquetes incluir.
  Conexiones con otros archivos:
    - Afecta a todo el proyecto: Controllers/, Models/, Views/, Program.cs, ApplicationDbContext, Migrations/.
    - Paquetes importantes: Entity Framework Core (Microsoft.EntityFrameworkCore) y Npgsql para PostgreSQL.
  Notas:
    - Cambios aquí requieren restaurar paquetes (__Restaurar paquetes__ o build en Visual Studio).
-->
<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<!-- Framework objetivo; modifica el runtime al publicar/ejecutar -->
		<TargetFramework>net9.0</TargetFramework>
		<!-- Habilita anotaciones nullable que ayudan a evitar null reference -->
		<Nullable>enable</Nullable>
		<!-- Importa automáticamente using comunes en archivos C# -->
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<!-- ORM principal para acceso a datos -->
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.10" />
		<!-- Herramientas de diseño de EF (migrations) -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<!-- Herramientas CLI de EF -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<!-- Provider de EF Core para PostgreSQL -->
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
	</ItemGroup>

</Project>
